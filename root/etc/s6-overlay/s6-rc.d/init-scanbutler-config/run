#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# /config holds the work folder (plans, caches, upload ledger) and the
# temporary page images.
mkdir -p /config

if [[ -z ${LSIO_NON_ROOT_USER} ]]; then
    lsiown abc:abc /config
    # Everything below it has to belong to abc too: after a changed PUID/PGID,
    # or a /config restored from another host, abc couldn't read its own
    # files (the API's token file crashed the service at start). Looking is
    # cheap; the recursive hand-over only runs when something is not abc's.
    if [[ -n $(find /config \( ! -user abc -o ! -group abc \) -print -quit) ]]; then
        echo "Handing /config over to abc (PUID/PGID changed?)"
        lsiown -R abc:abc /config
    fi

    # Input roots that Docker created itself (a missing host folder, or a
    # fresh volume) belong to root, and abc couldn't create inbox/ and the
    # rest there. Only those are handed over; folders that already belong to
    # someone else are left as they are.
    for dir in "${DATA_DIR:-/data}" "${STACKS_DIR:-${DATA_DIR:-/data}/stacks}" \
               "${SCANNER_DIR:-${DATA_DIR:-/data}/scanner}" "${PAPERLESS_DIR:-${DATA_DIR:-/data}/paperless}" \
               "${PAPERLESS_2_DIR:-${DATA_DIR:-/data}/paperless-2}"; do
        if [[ -d ${dir} && $(stat -c %u "${dir}") == 0 ]]; then
            lsiown abc:abc "${dir}"
        fi
    done
fi

# A wrong setting stops the container here, with one message. In the service
# it would only exit with code 2 and s6 would restart it every second.
# The check runs as abc, like the service, so it sees what the service sees.
if [[ -z ${LSIO_NON_ROOT_USER} ]]; then
    check=(s6-setuidgid abc python3 -m scanbutler check-config)
else
    check=(python3 -m scanbutler check-config)
fi
if ! reason=$(HOME=/config "${check[@]}" 2>&1); then
    echo "ERROR: ${reason}"
    exit 1
fi
