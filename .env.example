# Copy to .env and fill in. .env is git-ignored.

# --- Required -----------------------------------------------------------------
MISTRAL_API_KEY=your-mistral-api-key

# --- Docker compose -----------------------------------------------------------
# Host folder mounted at /data, and the user/group that owns it.
DATA_PATH=./data
PUID=1000
PGID=1000

# --- Models -------------------------------------------------------------------
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_LLM_MODEL=mistral-medium-latest

# --- Naming -------------------------------------------------------------------
# Language for titles and summaries (default: the language of the document).
# TITLE_LANGUAGE=German
# {title} is required, {date} is YYYY-MM-DD.
# FILENAME_PATTERN={title} {date}
# NO_DATE_LABEL=undated

# --- Splitting ----------------------------------------------------------------
# Pages per LLM request, and how far each window moves on.
# BOUNDARY_WINDOW=12
# BOUNDARY_STEP=6
# Documents with a split decision below this confidence are flagged in review.md.
# REVIEW_CONFIDENCE=0.75
# DROP_BLANK_PAGES=true
# BLANK_MAX_CHARS=15

# --- Text layer (ocrmypdf / Tesseract) ---------------------------------------
# OCRMYPDF_ENABLED=true
# OCRMYPDF_LANGUAGES=deu+eng
# OCRMYPDF_JOBS=4
# OCRMYPDF_EXTRA_ARGS=

# --- Throughput ---------------------------------------------------------------
# OCR_CHUNK_PAGES=50
# OCR_CONCURRENCY=3
# LLM_CONCURRENCY=4
# POLL_INTERVAL=30
# STABLE_SECONDS=60
# LOG_LEVEL=INFO
